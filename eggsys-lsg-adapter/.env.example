# Base de datos (docker-compose la sobreescribe; este valor es para correr fuera de Docker)
DATABASE_URL=postgresql+asyncpg://lsg:lsgthesismv@localhost:5433/eggsys_lsg
PORT=14142
DEBUG=false

# Servicios LSG
LSG_AUTH_BASE_URL=https://lsg.diinf.usach.cl/lsg-auth
LSG_CORE_BASE_URL=https://lsg.diinf.usach.cl/lsg-core-api

# Cuenta de servicio (rol admin/cross-player): acredita puntos en nombre de
# cualquier jugador via POST /players/{id}/points/adjust. Vacia -> fallback al
# token del propio usuario (webhook player-self; adjust con rol researcher).
LSG_SERVICE_EMAIL=
LSG_SERVICE_PASSWORD=

# Secreto compartido con EggSys (mismo valor que LSG_INGEST_SECRET en EggSys)
EGGSYS_INGEST_SECRET=

# Claves Fernet para cifrar las credenciales que el usuario acepte guardar, de
# modo que el adaptador reconecte solo cuando su token LSG expire (vida 120 min).
# Separadas por comas, la mas nueva primero: rotar = anteponer una clave y las
# viejas siguen descifrando.
# Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# OBLIGATORIA: cifra tambien el token de sesion de cada usuario, haya aceptado
# o no guardar su contrasena. Vacio -> /link responde 503 y no hay vinculo.
# Borrar esta variable NO borra lo ya guardado: los tokens y credenciales
# quedan ilegibles hasta reponerla.
LSG_CREDENTIAL_KEYS=

# Fase 0: completar con scripts/provision_sensor.py
EGGSYS_SENSOR_ID=0
# Endpoint por defecto (para event_type fuera del mapa de abajo)
EGGSYS_SENSOR_ENDPOINT_ID=0
# Un endpoint por conducta (ver docs/lsg-sensor-endpoints.md)
EGGSYS_ENDPOINT_IDS={"streak.daily_logging": 0, "budget.month_met": 0, "savings.milestone": 0, "tx.descriptive_entry": 0}
# OJO: son id_point_dimension, NO attribute_id (no coinciden para Linguistico:
# attribute_id=5 -> id_point_dimension=7; el 5 es CONDICION_FISICA).
# Ver GET /admin/point-dimensions. Si quedan en 0, el adaptador no arranca.
POINT_DIMENSION_COGNITIVO=0
POINT_DIMENSION_AFECTIVO=0
POINT_DIMENSION_LINGUISTICO=0

# Topes globales anti-farmeo
CAP_DAILY=20
CAP_WEEKLY=60
CAP_MONTHLY=150
RETRY_MAX_ATTEMPTS=5
